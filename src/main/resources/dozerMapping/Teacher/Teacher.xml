<?xml version="1.0" encoding="UTF-8"?>
<mappings xmlns="http://dozer.sourceforge.net"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://dozer.sourceforge.net https://dozer.sourceforge.net/schema/beanmapping.xsd">
    <mapping>
        <class-a>ir.projectMohammadi.model.teacher.Teacher</class-a>
        <class-b>ir.projectMohammadi.web.viewModel.teacher.TeacherViewModel</class-b>
        <field>
            <a>course</a>
            <b>course</b>
        </field>
        <field>
            <a>administrator.ID</a>
            <b>administratorId</b>
            <a-hint>java.lang.Long</a-hint>
            <b-hint>java.lang.Long</b-hint>
        </field>
        <field type="one-way">
            <a>administrator.lastName</a>
            <b>administratorLastName</b>
            <a-hint>java.lang.String</a-hint>
            <b-hint>java.lang.String</b-hint>
        </field>
    </mapping>
</mappings>